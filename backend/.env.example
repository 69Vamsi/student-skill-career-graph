# Copy this file to .env and fill in values locally.
# Do not commit a real .env file.

# Application
APP_NAME=Student Skill Career Graph API
APP_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# CognoDB (used in a later phase — leave blank for now)
# Official connection uses a bolt+s:// URI, username, and password.
COGNODB_URI=
COGNODB_USER=
COGNODB_PASSWORD=
